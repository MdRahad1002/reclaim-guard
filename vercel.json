{
  "version": 2,
  "buildCommand": "npm install",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "thank-you.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "analytics.js", "use": "@vercel/static" },
    { "src": "i18n.js", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "404.html", "use": "@vercel/static" },
    { "src": "blog.html", "use": "@vercel/static" },
    { "src": "blog/what-to-do-after-being-scammed.html", "use": "@vercel/static" },
    { "src": "blog/how-to-spot-crypto-recovery-scam.html", "use": "@vercel/static" },
    { "src": "blog/most-common-crypto-scams-2026.html", "use": "@vercel/static" },
    { "src": "blog/what-is-a-chargeback.html", "use": "@vercel/static" },
    { "src": "blog/blockchain-forensics-traces-stolen-crypto.html", "use": "@vercel/static" },
    { "src": "blog/de/was-tun-nach-betrug.html", "use": "@vercel/static" },
    { "src": "blog/de/krypto-rueckgewinnungsbetrug-erkennen.html", "use": "@vercel/static" },
    { "src": "blog/de/haeufigste-krypto-betrugsmaschen-2026.html", "use": "@vercel/static" },
    { "src": "blog/de/was-ist-eine-rueckbuchung.html", "use": "@vercel/static" },
    { "src": "blog/de/blockchain-forensik-krypto-verfolgen.html", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/leads/export/csv", "dest": "/api/leads/index.js" },
    { "src": "/api/leads/([0-9]+)", "dest": "/api/leads/index.js?id=$1" },
    { "src": "/api/leads", "dest": "/api/leads/index.js" },
    { "src": "/api/auth/login", "dest": "/api/auth/login.js" },
    { "src": "/api/auth/verify", "dest": "/api/auth/verify.js" },
    { "src": "/api/geo", "dest": "/api/geo.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/analytics.js", "dest": "/analytics.js" },
    { "src": "/i18n.js", "dest": "/i18n.js" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/thank-you", "dest": "/thank-you.html" },
    { "src": "/thank-you.html", "dest": "/thank-you.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/privacy.html", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/terms.html", "dest": "/terms.html" },
    { "src": "/blog", "dest": "/blog.html" },
    { "src": "/blog.html", "dest": "/blog.html" },
    { "src": "/blog/what-to-do-after-being-scammed", "dest": "/blog/what-to-do-after-being-scammed.html" },
    { "src": "/blog/what-to-do-after-being-scammed.html", "dest": "/blog/what-to-do-after-being-scammed.html" },
    { "src": "/blog/how-to-spot-crypto-recovery-scam", "dest": "/blog/how-to-spot-crypto-recovery-scam.html" },
    { "src": "/blog/how-to-spot-crypto-recovery-scam.html", "dest": "/blog/how-to-spot-crypto-recovery-scam.html" },
    { "src": "/blog/most-common-crypto-scams-2026", "dest": "/blog/most-common-crypto-scams-2026.html" },
    { "src": "/blog/most-common-crypto-scams-2026.html", "dest": "/blog/most-common-crypto-scams-2026.html" },
    { "src": "/blog/what-is-a-chargeback", "dest": "/blog/what-is-a-chargeback.html" },
    { "src": "/blog/what-is-a-chargeback.html", "dest": "/blog/what-is-a-chargeback.html" },
    { "src": "/blog/blockchain-forensics-traces-stolen-crypto", "dest": "/blog/blockchain-forensics-traces-stolen-crypto.html" },
    { "src": "/blog/blockchain-forensics-traces-stolen-crypto.html", "dest": "/blog/blockchain-forensics-traces-stolen-crypto.html" },
    { "src": "/blog/de/was-tun-nach-betrug", "dest": "/blog/de/was-tun-nach-betrug.html" },
    { "src": "/blog/de/was-tun-nach-betrug.html", "dest": "/blog/de/was-tun-nach-betrug.html" },
    { "src": "/blog/de/krypto-rueckgewinnungsbetrug-erkennen", "dest": "/blog/de/krypto-rueckgewinnungsbetrug-erkennen.html" },
    { "src": "/blog/de/krypto-rueckgewinnungsbetrug-erkennen.html", "dest": "/blog/de/krypto-rueckgewinnungsbetrug-erkennen.html" },
    { "src": "/blog/de/haeufigste-krypto-betrugsmaschen-2026", "dest": "/blog/de/haeufigste-krypto-betrugsmaschen-2026.html" },
    { "src": "/blog/de/haeufigste-krypto-betrugsmaschen-2026.html", "dest": "/blog/de/haeufigste-krypto-betrugsmaschen-2026.html" },
    { "src": "/blog/de/was-ist-eine-rueckbuchung", "dest": "/blog/de/was-ist-eine-rueckbuchung.html" },
    { "src": "/blog/de/was-ist-eine-rueckbuchung.html", "dest": "/blog/de/was-ist-eine-rueckbuchung.html" },
    { "src": "/blog/de/blockchain-forensik-krypto-verfolgen", "dest": "/blog/de/blockchain-forensik-krypto-verfolgen.html" },
    { "src": "/blog/de/blockchain-forensik-krypto-verfolgen.html", "dest": "/blog/de/blockchain-forensik-krypto-verfolgen.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
