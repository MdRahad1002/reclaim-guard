{
  "version": 2,
  "buildCommand": "npm install",
  "public": true,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/(?!api).*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|json|txt|xml|woff|woff2|ttf|eot)$",
      "headers": {
        "cache-control": "public, max-age=3600"
      },
      "dest": "/$1"
    },
    {
      "src": "/admin(?:/.*)?$",
      "dest": "/admin.html"
    },
    {
      "src": "/privacy(?:/.*)?$",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms(?:/.*)?$",
      "dest": "/terms.html"
    },
    {
      "src": "/(?!api).*",
      "dest": "/index.html"
    }
  ]
}
